
const mongoose = require('mongoose');
const Schema = mongoose.Schema;

const taskSchema = new Schema({

	title: {
        type: String,
        unique: false
    },

	desc: {
    	type: String,
    	unique: false
	},

	priority: {
    	type: String,
    	enum: ["Low", "Medium", "High"],
    	default: "Medium"
	},

    date: {
        type: String,
        enum: ["Mon", "Tues", "Wed", "Thurs", "Fri", "Sat", "Sun"],
        default: "Mon"
    }

});

module.exports = mongoose.model("Task", taskSchema);